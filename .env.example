# Gemini is optional; without it the app returns cited source excerpts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
SYNTHESIS_ENABLED=true
ENVIRONMENT=development
QDRANT_PATH=./data/qdrant
DATABASE_PATH=./data/sample.db
# Set the same strong secret here and in Vercel. Required in production.
BACKEND_API_KEY=
# Optional hosted Qdrant (otherwise use a persistent local disk, one worker).
QDRANT_URL=
QDRANT_API_KEY=
WEB_SEARCH_ENABLED=true
# Comma-separated browser origins. The Next.js proxy normally avoids CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
